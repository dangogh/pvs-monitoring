#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

DESTDIR ?= debian/pvs-monitoring
export PATH := $(HOME)/go/bin:$(PATH)

%:
	dh $@ --without usrlocal --without dwz

# DEB_HOST_ARCH (arm64/amd64) matches Go's GOARCH naming for our supported
# targets, so it can be passed straight through. Only dh_auto_build cross-
# compiles for the host arch; dh_auto_test below builds/runs natively so
# tests don't require emulation.
# Version stamped into the binaries, taken from the changelog entry dch just wrote
# (so it matches the .deb package version). Prefixed with 'v' to match release tags.
VERSION := v$(shell dpkg-parsechangelog -SVersion)
GO_LDFLAGS := -s -w -X github.com/dangogh/pvs-monitoring/internal/version.Version=$(VERSION)

override_dh_auto_build:
	GOOS=linux GOARCH=$(DEB_HOST_ARCH) CGO_ENABLED=0 go build -buildvcs=false -ldflags="$(GO_LDFLAGS)" -o bin/pvs-monitor ./cmd/pvs-monitor
	GOOS=linux GOARCH=$(DEB_HOST_ARCH) CGO_ENABLED=0 go build -buildvcs=false -ldflags="$(GO_LDFLAGS)" -o bin/pvs-api ./cmd/pvs-api
	GOOS=linux GOARCH=$(DEB_HOST_ARCH) CGO_ENABLED=0 go build -buildvcs=false -ldflags="$(GO_LDFLAGS)" -o bin/pvs-ui ./cmd/pvs-ui

override_dh_auto_install:
	# Install binaries
	install -D -m 755 bin/pvs-monitor $(DESTDIR)/usr/bin/pvs-monitor
	install -D -m 755 bin/pvs-api $(DESTDIR)/usr/bin/pvs-api
	install -D -m 755 bin/pvs-ui $(DESTDIR)/usr/bin/pvs-ui
	
	# Install systemd services
	install -D -m 644 debian/pvs-monitor.service $(DESTDIR)/etc/systemd/system/pvs-monitor.service
	install -D -m 644 debian/pvs-api.service $(DESTDIR)/etc/systemd/system/pvs-api.service
	install -D -m 644 debian/pvs-ui.service $(DESTDIR)/etc/systemd/system/pvs-ui.service

	# Install the example config. The seed copy that postinst turns into the
	# live config.yaml on a fresh install goes under /usr/share, NOT /etc:
	# anything shipped under /etc is registered as a conffile, and postinst
	# deletes its own seed file on every upgrade that already has a config.
	# dpkg then sees a conffile "deleted by you or by a script" and prompts
	# interactively on the next upgrade — which wedges the unattended cron
	# updater, since it has no stdin to answer with.
	install -D -m 644 config.example.yaml $(DESTDIR)/etc/pvs-monitor/config.yaml.example
	install -D -m 644 config.example.yaml $(DESTDIR)/usr/share/pvs-monitoring/config.yaml.default

	# Install update script
	install -D -m 755 pvs-update.sh $(DESTDIR)/usr/bin/pvs-update

	# Install sudoers drop-in for passwordless deployment
	install -D -m 440 debian/pvs-monitor.sudoers $(DESTDIR)/etc/sudoers.d/pvs-monitor

override_dh_auto_test:
	go test ./...

override_dh_strip:
	# Skip stripping for Go binaries

override_dh_makeshlibs:
	# Static Go binaries (CGO_ENABLED=0) have no shared library dependencies,
	# and running this needs a cross-arch objdump we don't install.

override_dh_shlibdeps:
	# Same reasoning as dh_makeshlibs above.
