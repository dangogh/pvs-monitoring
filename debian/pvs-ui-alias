#!/bin/sh
# Publish a friendly mDNS alias for the PVS dashboard so it is reachable on the
# LAN at http://<UI_ALIAS>.local (no port). The host itself is not renamed.
#
# The name comes from UI_ALIAS in /etc/pvs-monitor/ui-alias.conf; an empty or
# unset value disables the alias (exit 0 so systemd treats it as done, not
# failed). Runs in the foreground under systemd, re-resolving the primary IP
# each start so it follows DHCP changes across restarts.
set -e

[ -r /etc/pvs-monitor/ui-alias.conf ] && . /etc/pvs-monitor/ui-alias.conf

if [ -z "${UI_ALIAS:-}" ]; then
	echo "pvs-ui-alias: UI_ALIAS not set in /etc/pvs-monitor/ui-alias.conf; no alias published" >&2
	exit 0
fi

IP=$(hostname -I | awk '{print $1}')
exec /usr/bin/avahi-publish -a -R "${UI_ALIAS}.local" "$IP"
