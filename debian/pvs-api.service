[Unit]
Description=PVS6 solar data API
After=network-online.target pvs-monitor.service
Wants=network-online.target
# pvs-api opens the DB read-only and does not migrate; pvs-monitor is the
# writer/migrator, so start it first to minimise the read-only readiness wait.
Wants=pvs-monitor.service

[Service]
User=pvs-monitoring
ExecStart=/usr/bin/pvs-api -db /var/lib/pvs-monitor/readings.db -tls-cert /var/lib/pvs-monitor/server.crt -tls-key /var/lib/pvs-monitor/server.key
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
